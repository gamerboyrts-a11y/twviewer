# Publish allowlist: source, screenshots, build inputs, and packaging metadata.
/*
!/.gitignore
!/Makefile
!/build.bat
!/README.md
!/icon.png
!/source/
!/source/**
!/screenshot/
!/screenshot/**
!/library/
!/library/**
!/romfs/
!/romfs/**
!/cia-build/
!/cia-build/**

# Local CIA tools and generated packaging work.
/cia-build/tools/*
!/cia-build/tools/README.md
/cia-build/work/

# Generated build and release artifacts.
build/
*.elf
*.3dsx
*.smdh
*.cia
*.cci
*.3ds

# Local configuration, logs, notes, references, and old builds.
/app_icon.png
/meta/
.cl*de/
CL*UDE.md
openspec/
reference/
config/
OLD BUILD 2.0/
build_log.txt
BUILDLOG.md
twitchadblocker
*.log

# Editor and OS files.
.vscode/
*.swp
Thumbs.db
.DS_Store

# Crash dumps and runtime-generated config.
dumps/
twitch_token.txt
twitch_settings.txt
twitch_channels.txt
